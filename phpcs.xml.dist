<?xml version="1.0"?>
<ruleset name="MPOS PHP 8.3 Compatibility">
    <description>
        PHPCompatibility scan targeting PHP 8.3.
        Bundled third-party libs (Smarty, Markdown, jsonRPCClient) are
        excluded — they'll be replaced or audited separately.
    </description>

    <file>cronjobs</file>
    <file>scripts</file>
    <file>include/classes</file>
    <file>include/pages</file>
    <file>include/config</file>
    <file>include/autoloader.inc.php</file>
    <file>include/bootstrap.php</file>
    <file>include/database.inc.php</file>
    <file>include/smarty.inc.php</file>
    <file>include/smarty_globals.inc.php</file>
    <file>include/version.inc.php</file>
    <file>public/index.php</file>
    <file>public/healthcheck.php</file>

    <exclude-pattern>*/include/smarty/*</exclude-pattern>
    <exclude-pattern>*/include/lib/*</exclude-pattern>
    <exclude-pattern>*/templates/compile/*</exclude-pattern>
    <exclude-pattern>*/templates/cache/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/upgrade/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <config name="testVersion" value="8.3"/>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PHPCompatibility"/>
</ruleset>
